@PACKAGE_INIT@
set(iiFileProvider_ANDROID_SOURCE_DIRECTORY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/iiFileProvider/android/src")
include("${CMAKE_CURRENT_LIST_DIR}/iiFileProviderAndroid.cmake")
include(CMakeFindDependencyMacro)
find_dependency(iiFileProviderNative 0.10.0 CONFIG HINTS "${CMAKE_CURRENT_LIST_DIR}/../iiFileProviderNative")
find_dependency(iiFileProviderCatalog @PROJECT_VERSION@ CONFIG HINTS "${CMAKE_CURRENT_LIST_DIR}/../iiFileProviderCatalog")
find_dependency(iiFileProviderTemporary CONFIG HINTS "${CMAKE_CURRENT_LIST_DIR}/../iiFileProviderTemporary")
if(NOT TARGET Qt6::Core)
    find_dependency(Qt6 6.8.3 EXACT COMPONENTS Core)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiFileProviderTargets.cmake")
if(APPLE)
    # Private consumers may build with their install RPATH, and ambient library
    # paths can suppress CMake's inferred build RPATH. Carry the actual package.
    set_property(TARGET iiFileProvider::iiFileProvider APPEND PROPERTY
        INTERFACE_LINK_OPTIONS "LINKER:-rpath,$<TARGET_FILE_DIR:iiFileProvider::iiFileProvider>")
endif()
check_required_components(iiFileProvider)
