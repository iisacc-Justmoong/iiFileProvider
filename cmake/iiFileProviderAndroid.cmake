# Merge owned Java sources into the target's existing package in build/.
function(iiFileProvider_add_android_storage target)
    if(NOT ANDROID)
        return()
    endif()
    if(NOT TARGET iiFileProvider::Native)
        find_package(iiFileProviderNative 0.6 CONFIG REQUIRED)
    endif()
    target_link_libraries(${target} PRIVATE iiFileProvider::Native)
    get_target_property(package ${target} QT_ANDROID_PACKAGE_SOURCE_DIR)
    set(destination "${CMAKE_CURRENT_BINARY_DIR}/ii-file-provider-android/${target}")
    file(MAKE_DIRECTORY "${destination}")
    if(package AND EXISTS "${package}")
        file(COPY "${package}/" DESTINATION "${destination}")
    endif()
    file(COPY "${iiFileProvider_ANDROID_SOURCE_DIRECTORY}/" DESTINATION "${destination}/src")
    set_property(TARGET ${target} PROPERTY QT_ANDROID_PACKAGE_SOURCE_DIR "${destination}")
endfunction()
