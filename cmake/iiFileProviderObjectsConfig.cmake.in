@PACKAGE_INIT@
set(iiFileProviderObjects_DOCUMENT_API_VERSION 1)
include(CMakeFindDependencyMacro)
find_dependency(iiFileProviderTemporary CONFIG HINTS "${CMAKE_CURRENT_LIST_DIR}/../iiFileProviderTemporary")
if(@IIFILEPROVIDER_USE_BUNDLED_SQLITE@)
    include("${CMAKE_CURRENT_LIST_DIR}/../iiFileProviderSQLite3/iiFileProviderSQLite3Config.cmake")
else()
    find_dependency(SQLite3 3.26)
endif()
find_dependency(Threads)
if(NOT TARGET SQLite3::SQLite3)
    add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiFileProviderObjectsTargets.cmake")
check_required_components(iiFileProviderObjects)
