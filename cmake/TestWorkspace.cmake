# Preserve direct target/emulator handling when tests are cross-compiled.
function(iifp_fixture_test name target)
    if(CMAKE_CROSSCOMPILING)
        set(_args)
        foreach(_arg IN LISTS ARGN)
            string(REPLACE "@WORK@" "${CMAKE_CURRENT_BINARY_DIR}" _arg "${_arg}")
            list(APPEND _args "${_arg}")
        endforeach()
        add_test(NAME "${name}" COMMAND "${target}" ${_args})
    else()
        add_test(NAME "${name}" COMMAND ${_iifp_test_runner} "$<TARGET_FILE:${target}>" ${ARGN})
    endif()
endfunction()

function(iifp_python_fixture_test name)
    if(CMAKE_CROSSCOMPILING)
        set(_args)
        foreach(_arg IN LISTS ARGN)
            string(REPLACE "@WORK@" "${CMAKE_CURRENT_BINARY_DIR}" _arg "${_arg}")
            list(APPEND _args "${_arg}")
        endforeach()
        add_test(NAME "${name}" COMMAND "${Python3_EXECUTABLE}" -B ${_args})
    else()
        add_test(NAME "${name}" COMMAND ${_iifp_test_runner} "${Python3_EXECUTABLE}" -B ${ARGN})
    endif()
endfunction()
