file(READ "${CMAKE_CURRENT_SOURCE_DIR}/third_party/dependencies.json" _native_manifest)
string(JSON _native_count LENGTH "${_native_manifest}" files)
math(EXPR _native_last "${_native_count}-1")
foreach(_native_index RANGE 0 ${_native_last})
    string(JSON _native_file GET "${_native_manifest}" files ${_native_index} file)
    string(JSON _native_sha GET "${_native_manifest}" files ${_native_index} sha256)
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/third_party/${_native_file}" _native_actual)
    if(NOT _native_sha STREQUAL _native_actual)
        message(FATAL_ERROR "Pinned Native provider dependency mismatch: ${_native_file}")
    endif()
endforeach()
